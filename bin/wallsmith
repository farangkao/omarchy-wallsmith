#!/bin/bash

set -euo pipefail

plugin_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
theme_context_enabled=true
mode="new"

while (( $# > 0 )); do
  case "$1" in
  --history)
    mode="history"
    shift
    ;;
  --no-theme-context)
    theme_context_enabled=false
    shift
    ;;
  -h | --help)
    echo "Usage: wallsmith [--history] [--no-theme-context] [prompt]"
    exit 0
    ;;
  --)
    shift
    break
    ;;
  -*)
    echo "Unknown option: $1" >&2
    exit 2
    ;;
  *)
    break
    ;;
  esac
done

prompt="$*"
history=$("$plugin_dir/bin/wallpaper-history")
if [[ $mode == history ]]; then
  [[ -z $prompt ]] || { echo "--history does not accept a prompt" >&2; exit 2; }
  payload=$(jq -cn \
    --arg mode "$mode" \
    --argjson history "$history" \
    '{mode: $mode, history: $history}')
else
  payload=$(jq -cn \
    --arg mode "$mode" \
    --arg prompt "$prompt" \
    --argjson history "$history" \
    --argjson themeContextEnabled "$theme_context_enabled" \
    '{mode: $mode, prompt: $prompt, history: $history, themeContextEnabled: $themeContextEnabled}')
fi
result=$(omarchy-shell shell summon jesperlugner.wallsmith "$payload")

if [[ $result != "ok" ]]; then
  echo "Wallpaper Agent is not available. Enable it with:" >&2
  echo "  omarchy plugin enable jesperlugner.wallsmith" >&2
  exit 1
fi
