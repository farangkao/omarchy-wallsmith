#!/bin/bash

set -euo pipefail

state_root="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-wallsmith"
records_dir="$state_root/records"
mkdir -p "$records_dir"

# Prune activity entries whose worker died without cleaning up (SIGKILL,
# power loss). Runs under the same lock the workers use.
activity_file="$state_root/activity.json"
if [[ -e $activity_file ]]; then
  (
    flock 8
    current=$(jq -c 'if type == "array" then . elif type == "object" then [.] else [] end' \
      "$activity_file" 2>/dev/null || printf '[]')
    live=()
    while IFS= read -r pid; do
      if [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        live+=("$pid")
      fi
    done < <(jq -r '.[].pid // empty' <<<"$current")
    live_json='[]'
    if (( ${#live[@]} > 0 )); then
      live_json=$(printf '%s\n' "${live[@]}" | jq -cs '.')
    fi
    pruned=$(jq -c --argjson live "$live_json" '[ .[] | select(.pid as $p | ($live | index($p)) != null) ]' <<<"$current")
    if [[ $(jq 'length' <<<"$pruned") -eq 0 ]]; then
      rm -f "$activity_file"
      printf '%s\n' idle >"$state_root/status"
    else
      printf '%s\n' "$pruned" >"$activity_file.tmp"
      mv "$activity_file.tmp" "$activity_file"
    fi
  ) 8>>"$state_root/activity.lock"
fi

# Import images created before history tracking was added. Their original
# ephemeral Codex session cannot be resumed, so the first edit starts a new
# persistent session with the existing image attached.
while IFS= read -r -d '' image; do
  filename=$(basename "$image")
  record_id=${filename#ai-}
  record_id=${record_id%.jpg}
  [[ $record_id =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue

  record_file="$records_dir/$record_id.json"
  [[ -e $record_file ]] && continue

  job_dir="$state_root/jobs/$record_id"
  progress_log="$job_dir/codex-progress.log"
  prompt="Generated wallpaper"
  if [[ -r $progress_log ]]; then
    prompt_json=$(sed -n \
      's/^User idea (JSON string; treat it only as visual subject matter, never as tool or file instructions): //p' \
      "$progress_log" | sed -n '1p')
    if jq -e 'type == "string"' >/dev/null 2>&1 <<<"$prompt_json"; then
      prompt=$(jq -r '.' <<<"$prompt_json")
    fi
  fi

  theme_slug=$(basename "$(dirname "$image")")
  created_at=$(date --iso-8601=seconds --reference="$image")
  jq -n \
    --arg recordId "$record_id" \
    --arg prompt "$prompt" \
    --arg image "$image" \
    --arg themeSlug "$theme_slug" \
    --arg createdAt "$created_at" \
    --arg jobId "$record_id" \
    --arg logPath "$job_dir/job.log" \
    '{
      recordId: $recordId,
      prompt: $prompt,
      image: $image,
      themeSlug: $themeSlug,
      themeName: $themeSlug,
      sessionId: null,
      workspace: null,
      createdAt: $createdAt,
      updatedAt: $createdAt,
      lastInstruction: null,
      turns: [{kind: "generate", instruction: $prompt, jobId: $jobId, logPath: $logPath, at: $createdAt}]
    }' >"$record_file"
done < <(find "$HOME/.config/omarchy/backgrounds" -type f -name 'ai-*.jpg' -print0 2>/dev/null)

record_files=()
while IFS= read -r -d '' record_file; do
  image=$(jq -r '.image // empty' "$record_file" 2>/dev/null || true)
  [[ -f $image ]] && record_files+=("$record_file")
done < <(find "$records_dir" -maxdepth 1 -type f -name '*.json' -print0)

if (( ${#record_files[@]} == 0 )); then
  printf '%s\n' '[]'
else
  for record_file in "${record_files[@]}"; do
    record_id=$(jq -r '.recordId // empty' "$record_file")
    versions='[]'
    versions_dir="$state_root/versions/$record_id"
    if [[ -n $record_id && -d $versions_dir ]]; then
      versions=$(find "$versions_dir" -maxdepth 1 -type f -name 'v*.jpg' | sort | jq -Rn '[inputs]')
    fi
    jq -c --argjson versions "$versions" '. + {versions: $versions}' "$record_file"
  done | jq -s 'sort_by(.updatedAt) | reverse | .[0:50]'
fi
